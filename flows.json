    {
        "id": "fn_sensor",
        "type": "function",
        "z": "flow_iot_v2",
        "name": "Proses Data Sensor",
        "func": "var data = msg.payload;\nif (typeof data !== 'object' || data === null) {\n    node.warn('Payload sensor bukan JSON object');\n    return null;\n}\nvar suhu = Number(data.suhu);\nvar kelembaban = Number(data.kelembaban);\nif (!Number.isFinite(suhu) || !Number.isFinite(kelembaban)) {\n    node.warn('Data sensor tidak valid: ' + JSON.stringify(data));\n    return null;\n}\n\nvar threshold = Number(flow.get('threshold'));\nif (!Number.isFinite(threshold)) threshold = 30;\n\nvar waktu = new Date().toISOString();\nvar hasil = {\n    suhu: suhu,\n    kelembaban: kelembaban,\n    timestamp: data.timestamp || waktu,\n    received: waktu,\n    threshold: threshold,\n    alert: suhu > threshold\n};\nflow.set('lastSensor', hasil);\n\n// Query dibuat lengkap dengan nilainya (mode msg.topic tidak mengikat tanda ?)\nvar sql = {\n    topic: \"INSERT INTO sensor_history (suhu, kelembaban, waktu) VALUES (\" +\n           suhu + \", \" + kelembaban + \", '\" + waktu + \"')\"\n};\n\nvar ws = { payload: hasil };\n\n// Notifikasi MQTT (maksimal 1 kali per 30 detik)\nvar notif = null;\nif (hasil.alert) {\n    var pesan = 'PERINGATAN! Suhu ' + suhu + '°C melewati batas ' + threshold + '°C';\n    node.warn(pesan);\n    var last = flow.get('lastAlertTime') || 0;\n    if (Date.now() - last > 30000) {\n        flow.set('lastAlertTime', Date.now());\n        notif = { topic: 'iot/alert', payload: { type: 'alert', message: pesan, suhu: suhu, threshold: threshold, waktu: waktu } };\n    }\n}\nreturn [ws, sql, notif];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 130,
        "wires": [
            [
                "ws_out",
                "dbg_sensor"
            ],
            [
                "sql_insert"
            ],
            [
                "mqtt_alert"
            ]
        ]
    },
