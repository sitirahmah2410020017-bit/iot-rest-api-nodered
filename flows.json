    {
        "id": "fn_thr",
        "type": "function",
        "z": "flow_iot_v2",
        "name": "Validasi Key & Simpan Threshold",
        "func": "if (msg.req.headers['x-api-key'] !== 'iot-rahasia-2026') {\n    msg.statusCode = 401;\n    msg.payload = { status: 'error', message: 'API Key tidak valid' };\n    return msg;\n}\nvar body = msg.payload || {};\nvar threshold = Number(body.threshold);\nif (body.threshold === undefined || !Number.isFinite(threshold) || threshold <= 0) {\n    msg.statusCode = 400;\n    msg.payload = { status: 'error', message: 'Nilai threshold harus berupa angka lebih dari 0' };\n    return msg;\n}\nflow.set('threshold', threshold);\nmsg.statusCode = 200;\nmsg.payload = { status: 'success', message: 'Threshold berhasil diperbarui', threshold: threshold };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
