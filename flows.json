        "type": "function",
        "z": "flow_iot_v2",
        "name": "Format History",
        "func": "var rows = Array.isArray(msg.payload) ? msg.payload : [];\nmsg.statusCode = 200;\nmsg.payload = {\n    status: 'success',\n    count: rows.length,\n    data: rows.reverse().map(function (r) {\n        return { suhu: r.suhu, kelembaban: r.kelembaban, timestamp: r.waktu, received: r.waktu };\n    })\n};\nreturn msg;",
